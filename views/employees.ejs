<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Employees</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css">
</head>
<body>
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Employee List</h3>
    <button class="btn btn-primary" id="addEmployeeBtn">Add New Employee</button>
  </div>

  <table id="employeeTable" class="table table-bordered table-striped">
    <thead>
      <tr>
        <th>Employee ID</th>
        <th>Name</th>
        <th>Department</th>
        <th>Job Title</th>
        <th>Salary</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody></tbody>
  </table>
</div>

<div class="modal fade" id="employeeModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form id="employeeForm">
        <div class="modal-header">
          <h5 class="modal-title" id="modalTitle">Add Employee</h5>
          <button type="button" class="close" data-dismiss="modal">&times;</button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="employeeId" name="employeeId">

          <div class="form-row">
            <div class="form-group col-md-6">
              <label>First Name</label>
              <input type="text" class="form-control" name="firstName" id="firstName">
            </div>
            <div class="form-group col-md-6">
              <label>Last Name</label>
              <input type="text" class="form-control" name="lastName" id="lastName">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group col-md-6">
              <label>Date of Birth</label>
              <input type="date" class="form-control" name="dateOfBirth" id="dateOfBirth">
            </div>
            <div class="form-group col-md-6">
              <label>SSN</label>
              <input type="text" class="form-control" name="socialSecurityNumber" id="socialSecurityNumber">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group col-md-4">
              <label>Gender</label>
              <select class="form-control" name="gender" id="gender">
                <option value="">Select</option>
                <option>Male</option>
                <option>Female</option>
                <option>Other</option>
              </select>
            </div>
            <div class="form-group col-md-8">
              <label>Address</label>
              <input type="text" class="form-control" name="address" id="address">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group col-md-6">
              <label>Phone Number</label>
              <input type="text" class="form-control" name="phoneNumber" id="phoneNumber">
            </div>
            <div class="form-group col-md-6">
              <label>Email Address</label>
              <input type="email" class="form-control" name="emailAddress" id="emailAddress">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group col-md-6">
              <label>Preferred Communication</label>
              <select class="form-control" name="preferredCommunication" id="preferredCommunication">
                <option value="">Select</option>
                <option>Email</option>
                <option>Phone</option>
              </select>
            </div>
            <div class="form-group col-md-6">
              <label>Job Title</label>
              <input type="text" class="form-control" name="jobTitle" id="jobTitle">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group col-md-6">
              <label>Department</label>
              <select class="form-control" name="department" id="department">
                <option value="">Select</option>
                <option>Sales</option>
                <option>Marketing</option>
                <option>Human Resources</option>
                <option>Finance</option>
                <option>Engineering</option>
                <option>Information Technology (IT)</option>
                <option>Customer Support</option>
                <option>Design</option>
              </select>
            </div>
            <div class="form-group col-md-6">
              <label>Salary</label>
              <input type="number" class="form-control" name="salary" id="salary">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-success" id="saveBtn">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
  let table;
  let editingId = null;

  $(document).ready(function () {
    // ── Initialize DataTable ────────────────────────────────────────────────
    table = $('#employeeTable').DataTable({
      ajax: {
        url: '/employees',
        dataSrc: 'data'
      },
      columns: [
        { data: 'employeeId' },
        {
          data: null,
          render: (d) => `${d.firstName} ${d.lastName}`
        },
        { data: 'department' },
        { data: 'jobTitle' },
        {
          data: 'salary',
          render: (val) => '$' + parseFloat(val).toLocaleString('en-US', { minimumFractionDigits: 2 })
        },
        {
          data: 'employeeId',
          orderable: false,
          render: (id) =>
            `<button class="btn btn-sm btn-warning edit-btn" data-id="${id}">Edit</button> ` +
            `<button class="btn btn-sm btn-danger delete-btn" data-id="${id}">Delete</button>`
        }
      ],
      order: [[0, 'desc']]
    });

    // ── Open modal for ADD ──────────────────────────────────────────────────
    $('#addEmployeeBtn').on('click', function () {
      editingId = null;
      $('#modalTitle').text('Add Employee');
      $('#employeeForm')[0].reset();
      $('#employeeId').val('');
      $('#employeeModal').modal('show');
    });

    // ── Open modal for EDIT ─────────────────────────────────────────────────
    $('#employeeTable').on('click', '.edit-btn', function () {
      const id = $(this).data('id');
      editingId = id;
      $('#modalTitle').text('Edit Employee');

      $.get(`/employees/${id}`, function (res) {
        if (!res.success) return;
        const e = res.data;
        $('#employeeId').val(e.employeeId);
        $('#firstName').val(e.firstName);
        $('#lastName').val(e.lastName);
        $('#dateOfBirth').val(e.dateOfBirth);
        $('#socialSecurityNumber').val(e.socialSecurityNumber);
        $('#gender').val(e.gender);
        $('#address').val(e.address);
        $('#phoneNumber').val(e.phoneNumber);
        $('#emailAddress').val(e.emailAddress);
        $('#preferredCommunication').val(e.preferredCommunication);
        $('#jobTitle').val(e.jobTitle);
        $('#department').val(e.department);
        $('#salary').val(e.salary);
        $('#employeeModal').modal('show');
      }).fail(function () {
        Swal.fire('Error', 'Could not load employee data.', 'error');
      });
    });

    // ── DELETE ──────────────────────────────────────────────────────────────
    $('#employeeTable').on('click', '.delete-btn', function () {
      const id = $(this).data('id');
      Swal.fire({
        title: 'Delete Employee?',
        text: 'This action cannot be undone.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Yes, delete'
      }).then((result) => {
        if (!result.isConfirmed) return;
        $.ajax({
          url: `/employees/${id}`,
          method: 'DELETE',
          success: function (res) {
            if (res.success) {
              Swal.fire('Deleted!', res.message, 'success');
              table.ajax.reload();
            }
          },
          error: function (xhr) {
            const msg = xhr.responseJSON?.message || 'Delete failed.';
            Swal.fire('Error', msg, 'error');
          }
        });
      });
    });

    // ── SAVE (Create / Update) ──────────────────────────────────────────────
    $('#employeeForm').on('submit', function (e) {
      e.preventDefault();

      const formData = {
        firstName:              $('#firstName').val().trim(),
        lastName:               $('#lastName').val().trim(),
        dateOfBirth:            $('#dateOfBirth').val(),
        socialSecurityNumber:   $('#socialSecurityNumber').val().trim(),
        gender:                 $('#gender').val(),
        address:                $('#address').val().trim(),
        phoneNumber:            $('#phoneNumber').val().trim(),
        emailAddress:           $('#emailAddress').val().trim(),
        preferredCommunication: $('#preferredCommunication').val(),
        jobTitle:               $('#jobTitle').val().trim(),
        department:             $('#department').val(),
        salary:                 $('#salary').val()
      };

      const isEdit  = !!editingId;
      const url     = isEdit ? `/employees/${editingId}` : '/employees';
      const method  = isEdit ? 'PUT' : 'POST';

      $.ajax({
        url,
        method,
        contentType: 'application/json',
        data: JSON.stringify(formData),
        success: function (res) {
          if (res.success) {
            $('#employeeModal').modal('hide');
            Swal.fire('Success', res.message, 'success');
            table.ajax.reload();
          }
        },
        error: function (xhr) {
          const json = xhr.responseJSON;
          const errors = json?.errors ? json.errors.join('\n') : (json?.message || 'Save failed.');
          Swal.fire('Validation Error', errors, 'error');
        }
      });
    });
  });
</script>
</body>
</html>