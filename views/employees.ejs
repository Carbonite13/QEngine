<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Employees</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css">
  <style>
    /* Hint text below inputs */
    .form-text { font-size: .78rem; color: #6c757d; margin-top: 2px; }

    /* Keep invalid-feedback always visible when field is dirty */
    .was-validated .form-control:invalid ~ .invalid-feedback,
    .was-validated .form-control:valid   ~ .valid-feedback,
    .field-dirty .form-control.is-invalid ~ .invalid-feedback { display: block; }

    /* Make invalid-feedback show even outside native :invalid */
    .form-control.is-invalid ~ .invalid-feedback { display: block; }
    .form-control.is-valid   ~ .valid-feedback   { display: block; }

    .modal-body .form-group { margin-bottom: .85rem; }
    label { font-weight: 500; font-size: .88rem; margin-bottom: 2px; }

    /* character counter */
    .char-count { float: right; font-size: .75rem; color: #aaa; }
  </style>
</head>
<body>
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Employee List</h3>
    <button class="btn btn-primary" id="addEmployeeBtn">Add New Employee</button>
  </div>

  <table id="employeeTable" class="table table-bordered table-striped">
    <thead>
      <tr>
        <th>Employee ID</th>
        <th>Name</th>
        <th>Department</th>
        <th>Job Title</th>
        <th>Salary</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody></tbody>
  </table>
</div>

<!-- ════════════════════════════════ MODAL ════════════════════════════════ -->
<div class="modal fade" id="employeeModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form id="employeeForm" novalidate>
        <div class="modal-header">
          <h5 class="modal-title" id="modalTitle">Add Employee</h5>
          <button type="button" class="close" data-dismiss="modal">&times;</button>
        </div>

        <div class="modal-body">
          <input type="hidden" id="employeeId" name="employeeId">

          <!-- Row 1 – First / Last Name -->
          <div class="form-row">
            <div class="form-group col-md-6">
              <label for="firstName">First Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="firstName" name="firstName"
                     placeholder="e.g. John" maxlength="40" autocomplete="given-name">
              <div class="invalid-feedback">Letters, spaces, hyphens and apostrophes only (1–40 chars).</div>
              <small class="form-text">Legal first name as it appears on official documents.</small>
            </div>
            <div class="form-group col-md-6">
              <label for="lastName">Last Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="lastName" name="lastName"
                     placeholder="e.g. Doe" maxlength="40" autocomplete="family-name">
              <div class="invalid-feedback">Letters, spaces, hyphens and apostrophes only (1–40 chars).</div>
              <small class="form-text">Legal last name — include suffix (Jr., III) if applicable.</small>
            </div>
          </div>

          <!-- Row 2 – DOB / SSN -->
          <div class="form-row">
            <div class="form-group col-md-6">
              <label for="dateOfBirth">Date of Birth <span class="text-danger">*</span></label>
              <input type="date" class="form-control" id="dateOfBirth" name="dateOfBirth"
                     autocomplete="bday">
              <div class="invalid-feedback" id="dobError">Employee must be at least 18 years old.</div>
              <small class="form-text">Must be in the past and employee must be ≥ 18 years old.</small>
            </div>
            <div class="form-group col-md-6">
              <label for="socialSecurityNumber">Social Security Number <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="socialSecurityNumber" name="socialSecurityNumber"
                     placeholder="000-00-0000" maxlength="11" inputmode="numeric" autocomplete="off">
              <div class="invalid-feedback">Enter a valid SSN in the format 000-00-0000.</div>
              <small class="form-text">Dashes are added automatically as you type.</small>
            </div>
          </div>

          <!-- Row 3 – Gender / Address -->
          <div class="form-row">
            <div class="form-group col-md-4">
              <label for="gender">Gender <span class="text-danger">*</span></label>
              <select class="form-control" id="gender" name="gender">
                <option value="">— Select —</option>
                <option>Male</option>
                <option>Female</option>
                <option>Other</option>
              </select>
              <div class="invalid-feedback">Please select a gender.</div>
            </div>
            <div class="form-group col-md-8">
              <label for="address">
                Address <span class="text-danger">*</span>
                <span class="char-count"><span id="addressCount">0</span>/80</span>
              </label>
              <input type="text" class="form-control" id="address" name="address"
                     placeholder="e.g. 123 Main St, Springfield, IL 62701"
                     maxlength="80" autocomplete="street-address">
              <div class="invalid-feedback">Address must be between 10 and 80 characters.</div>
              <small class="form-text">Include street, city, state, and ZIP code.</small>
            </div>
          </div>

          <!-- Row 4 – Phone / Email -->
          <div class="form-row">
            <div class="form-group col-md-6">
              <label for="phoneNumber">Phone Number <span class="text-danger">*</span></label>
              <input type="tel" class="form-control" id="phoneNumber" name="phoneNumber"
                     placeholder="e.g. 555-867-5309" maxlength="12" inputmode="numeric"
                     autocomplete="tel">
              <div class="invalid-feedback">Enter exactly 10 digits (dashes added automatically).</div>
              <small class="form-text">10-digit US number; dashes added automatically.</small>
            </div>
            <div class="form-group col-md-6">
              <label for="emailAddress">Email Address <span class="text-danger">*</span></label>
              <input type="email" class="form-control" id="emailAddress" name="emailAddress"
                     placeholder="e.g. john.doe@company.com" autocomplete="email">
              <div class="invalid-feedback">Enter a valid email address (e.g. user@domain.com).</div>
              <small class="form-text">Work email preferred.</small>
            </div>
          </div>

          <!-- Row 5 – Preferred Communication / Job Title -->
          <div class="form-row">
            <div class="form-group col-md-6">
              <label for="preferredCommunication">Preferred Communication <span class="text-danger">*</span></label>
              <select class="form-control" id="preferredCommunication" name="preferredCommunication">
                <option value="">— Select —</option>
                <option>Email</option>
                <option>Phone</option>
              </select>
              <div class="invalid-feedback">Please select a preferred communication method.</div>
              <small class="form-text">How should we contact this employee?</small>
            </div>
            <div class="form-group col-md-6">
              <label for="jobTitle">
                Job Title <span class="text-danger">*</span>
                <span class="char-count"><span id="jobTitleCount">0</span>/60</span>
              </label>
              <input type="text" class="form-control" id="jobTitle" name="jobTitle"
                     placeholder="e.g. Senior Software Engineer" maxlength="60">
              <div class="invalid-feedback">Job title is required (max 60 characters).</div>
              <small class="form-text">Use the official title from the employment contract.</small>
            </div>
          </div>

          <!-- Row 6 – Department / Salary -->
          <div class="form-row">
            <div class="form-group col-md-6">
              <label for="department">Department <span class="text-danger">*</span></label>
              <select class="form-control" id="department" name="department">
                <option value="">— Select —</option>
                <option>Sales</option>
                <option>Marketing</option>
                <option>Human Resources</option>
                <option>Finance</option>
                <option>Engineering</option>
                <option>Information Technology (IT)</option>
                <option>Customer Support</option>
                <option>Design</option>
              </select>
              <div class="invalid-feedback">Please select a department.</div>
            </div>
            <div class="form-group col-md-6">
              <label for="salary">Annual Salary (USD) <span class="text-danger">*</span></label>
              <div class="input-group">
                <div class="input-group-prepend">
                  <span class="input-group-text">$</span>
                </div>
                <input type="number" class="form-control" id="salary" name="salary"
                       placeholder="e.g. 75000" min="0" step="0.01">
                <div class="invalid-feedback">Enter a valid positive salary (e.g. 75000.00).</div>
              </div>
              <small class="form-text mt-1">Gross annual compensation before tax.</small>
            </div>
          </div>

        </div><!-- /modal-body -->

        <div class="modal-footer d-flex justify-content-between align-items-center">
          <small class="text-muted"><span class="text-danger">*</span> Required fields</small>
          <div>
            <button type="button" class="btn btn-secondary mr-2" data-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-success" id="saveBtn">Save Employee</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
<!-- ═══════════════════════════ END MODAL ═══════════════════════════════ -->

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
  /* ══════════════════════════════════════════════════════════════════════════
     Helpers
  ══════════════════════════════════════════════════════════════════════════ */

  // Max DOB = today minus 18 years (min employee age)
  function maxDOB() {
    const d = new Date();
    d.setFullYear(d.getFullYear() - 18);
    return d.toISOString().split('T')[0];
  }

  // Min DOB = today minus 120 years (max employee age – not surfaced to user)
  function minDOB() {
    const d = new Date();
    d.setFullYear(d.getFullYear() - 120);
    return d.toISOString().split('T')[0];
  }

  // SSN auto-mask  000-00-0000
  function formatSSN(raw) {
    const digits = raw.replace(/\D/g, '').slice(0, 9);
    if (digits.length <= 3)  return digits;
    if (digits.length <= 5)  return digits.slice(0,3) + '-' + digits.slice(3);
    return digits.slice(0,3) + '-' + digits.slice(3,5) + '-' + digits.slice(5);
  }

  // Phone auto-mask  000-000-0000
  function formatPhone(raw) {
    const digits = raw.replace(/\D/g, '').slice(0, 10);
    if (digits.length <= 3)  return digits;
    if (digits.length <= 6)  return digits.slice(0,3) + '-' + digits.slice(3);
    return digits.slice(0,3) + '-' + digits.slice(3,6) + '-' + digits.slice(6);
  }

  // Strip non-digits (send bare digits to API)
  function digitsOnly(str) { return str.replace(/\D/g, ''); }

  const NAME_RE   = /^[A-Za-z\s'.\-]+$/;
  const EMAIL_RE  = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  /* ══════════════════════════════════════════════════════════════════════════
     Per-field validators   returns "" if OK, else error message
  ══════════════════════════════════════════════════════════════════════════ */
  const validators = {
    firstName(v)              { return v && NAME_RE.test(v) && v.length <= 40 ? '' : 'Letters, spaces, hyphens and apostrophes only (1–40 chars).'; },
    lastName(v)               { return v && NAME_RE.test(v) && v.length <= 40 ? '' : 'Letters, spaces, hyphens and apostrophes only (1–40 chars).'; },
    dateOfBirth(v)            {
      if (!v) return 'Date of birth is required.';
      const dob = new Date(v);
      const max = new Date(maxDOB());
      const min = new Date(minDOB());
      if (dob > new Date())  return 'Date of birth must be in the past.';
      if (dob > max)         return 'Employee must be at least 18 years old.';
      if (dob < min)         return 'Please enter a valid date of birth.';
      return '';
    },
    socialSecurityNumber(v)   { return /^\d{3}-\d{2}-\d{4}$/.test(v) ? '' : 'Enter a valid SSN in the format 000-00-0000.'; },
    gender(v)                 { return v ? '' : 'Please select a gender.'; },
    address(v)                { return v && v.length >= 10 && v.length <= 80 ? '' : 'Address must be between 10 and 80 characters.'; },
    phoneNumber(v)            { return /^\d{3}-\d{3}-\d{4}$/.test(v) ? '' : 'Enter exactly 10 digits.'; },
    emailAddress(v)           { return EMAIL_RE.test(v) ? '' : 'Enter a valid email address (e.g. user@domain.com).'; },
    preferredCommunication(v) { return v ? '' : 'Please select a preferred communication method.'; },
    jobTitle(v)               { return v && v.trim().length >= 1 && v.length <= 60 ? '' : 'Job title is required (max 60 characters).'; },
    department(v)             { return v ? '' : 'Please select a department.'; },
    salary(v)                 { return v !== '' && !isNaN(v) && parseFloat(v) >= 0 ? '' : 'Enter a valid positive salary.'; }
  };

  function validateField(id) {
    const $el  = $('#' + id);
    const val  = $el.val() ? $el.val().trim() : '';
    const msg  = validators[id] ? validators[id](val) : '';
    const $err = $el.next('.invalid-feedback').length
                   ? $el.next('.invalid-feedback')
                   : $el.closest('.input-group').next('.invalid-feedback');

    if (msg) {
      $el.addClass('is-invalid').removeClass('is-valid');
      if ($err.length && msg !== $err.text()) $err.text(msg);
      return false;
    }
    $el.removeClass('is-invalid').addClass('is-valid');
    return true;
  }

  function validateAll() {
    const fields = ['firstName','lastName','dateOfBirth','socialSecurityNumber',
                    'gender','address','phoneNumber','emailAddress',
                    'preferredCommunication','jobTitle','department','salary'];
    let ok = true;
    fields.forEach(id => { if (!validateField(id)) ok = false; });
    return ok;
  }

  function clearValidation() {
    $('#employeeForm .form-control').removeClass('is-valid is-invalid');
    $('#addressCount').text('0');
    $('#jobTitleCount').text('0');
  }

  /* ══════════════════════════════════════════════════════════════════════════
     Bootstrap DataTable + CRUD
  ══════════════════════════════════════════════════════════════════════════ */
  let table;
  let editingId = null;

  $(document).ready(function () {

    // Set max DOB attribute
    $('#dateOfBirth').attr('max', maxDOB()).attr('min', minDOB());

    // ── SSN masking ────────────────────────────────────────────────────────
    $('#socialSecurityNumber').on('input', function () {
      const pos    = this.selectionStart;
      const before = this.value;
      const masked = formatSSN(this.value);
      this.value   = masked;
      // Keep caret roughly in place
      if (masked.length > before.length) this.setSelectionRange(pos + 1, pos + 1);
    }).on('blur', function () { validateField('socialSecurityNumber'); });

    // ── Phone masking ──────────────────────────────────────────────────────
    $('#phoneNumber').on('input', function () {
      const pos    = this.selectionStart;
      const before = this.value;
      const masked = formatPhone(this.value);
      this.value   = masked;
      if (masked.length > before.length) this.setSelectionRange(pos + 1, pos + 1);
    }).on('blur', function () { validateField('phoneNumber'); });

    // ── Live validation on blur / change ──────────────────────────────────
    $('#employeeForm').on('blur', '.form-control', function () {
      validateField(this.id);
    }).on('change', 'select', function () {
      validateField(this.id);
    });

    // ── Char counters ──────────────────────────────────────────────────────
    $('#address').on('input', function () {
      $('#addressCount').text(this.value.length);
      if (this.value.length > 0) validateField('address');
    });
    $('#jobTitle').on('input', function () {
      $('#jobTitleCount').text(this.value.length);
      if (this.value.length > 0) validateField('jobTitle');
    });

    // ── DataTable ──────────────────────────────────────────────────────────
    table = $('#employeeTable').DataTable({
      ajax: { url: '/employees', dataSrc: 'data' },
      columns: [
        { data: 'employeeId' },
        { data: null, render: d => `${d.firstName} ${d.lastName}` },
        { data: 'department' },
        { data: 'jobTitle' },
        { data: 'salary',     render: v => '$' + parseFloat(v).toLocaleString('en-US', { minimumFractionDigits: 2 }) },
        {
          data: 'employeeId', orderable: false,
          render: id =>
            `<button class="btn btn-sm btn-warning edit-btn"   data-id="${id}">Edit</button> ` +
            `<button class="btn btn-sm btn-danger  delete-btn" data-id="${id}">Delete</button>`
        }
      ],
      order: [[0, 'desc']]
    });

    // ── Open modal – ADD ───────────────────────────────────────────────────
    $('#addEmployeeBtn').on('click', function () {
      editingId = null;
      $('#modalTitle').text('Add Employee');
      $('#employeeForm')[0].reset();
      $('#employeeId').val('');
      clearValidation();
      $('#employeeModal').modal('show');
    });

    // ── Open modal – EDIT ──────────────────────────────────────────────────
    $('#employeeTable').on('click', '.edit-btn', function () {
      const id = $(this).data('id');
      editingId = id;
      $('#modalTitle').text('Edit Employee');

      $.get(`/employees/${id}`, function (res) {
        if (!res.success) return;
        const e = res.data;
        clearValidation();
        $('#employeeId').val(e.employeeId);
        $('#firstName').val(e.firstName);
        $('#lastName').val(e.lastName);
        $('#dateOfBirth').val(e.dateOfBirth);
        // Display SSN with dashes
        $('#socialSecurityNumber').val(formatSSN(e.socialSecurityNumber));
        $('#gender').val(e.gender);
        $('#address').val(e.address);
        $('#addressCount').text((e.address || '').length);
        // Display phone with dashes
        $('#phoneNumber').val(formatPhone(e.phoneNumber));
        $('#emailAddress').val(e.emailAddress);
        $('#preferredCommunication').val(e.preferredCommunication);
        $('#jobTitle').val(e.jobTitle);
        $('#jobTitleCount').text((e.jobTitle || '').length);
        $('#department').val(e.department);
        $('#salary').val(e.salary);
        $('#employeeModal').modal('show');
      }).fail(function () {
        Swal.fire('Error', 'Could not load employee data.', 'error');
      });
    });

    // ── DELETE ─────────────────────────────────────────────────────────────
    $('#employeeTable').on('click', '.delete-btn', function () {
      const id = $(this).data('id');
      Swal.fire({
        title: 'Delete Employee?',
        text: 'This action cannot be undone.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Yes, delete'
      }).then(result => {
        if (!result.isConfirmed) return;
        $.ajax({
          url: `/employees/${id}`, method: 'DELETE',
          success(res) {
            if (res.success) { Swal.fire('Deleted!', res.message, 'success'); table.ajax.reload(); }
          },
          error(xhr) {
            Swal.fire('Error', xhr.responseJSON?.message || 'Delete failed.', 'error');
          }
        });
      });
    });

    // ── SAVE (Create / Update) ─────────────────────────────────────────────
    $('#employeeForm').on('submit', function (ev) {
      ev.preventDefault();

      if (!validateAll()) {
        // Scroll to first invalid field
        const $first = $('#employeeForm .is-invalid').first();
        if ($first.length) $first[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      const formData = {
        firstName:              $('#firstName').val().trim(),
        lastName:               $('#lastName').val().trim(),
        dateOfBirth:            $('#dateOfBirth').val(),
        // Send bare digits to backend (backend regex: /^[0-9A-Za-z-]{4,20}$/ allows dashes)
        socialSecurityNumber:   $('#socialSecurityNumber').val().trim(),
        gender:                 $('#gender').val(),
        address:                $('#address').val().trim(),
        phoneNumber:            digitsOnly($('#phoneNumber').val()),   // 10 digits
        emailAddress:           $('#emailAddress').val().trim(),
        preferredCommunication: $('#preferredCommunication').val(),
        jobTitle:               $('#jobTitle').val().trim(),
        department:             $('#department').val(),
        salary:                 $('#salary').val()
      };

      const isEdit = !!editingId;
      const url    = isEdit ? `/employees/${editingId}` : '/employees';
      const method = isEdit ? 'PUT' : 'POST';

      $('#saveBtn').prop('disabled', true).text('Saving…');

      $.ajax({
        url, method,
        contentType: 'application/json',
        data: JSON.stringify(formData),
        success(res) {
          if (res.success) {
            $('#employeeModal').modal('hide');
            Swal.fire({ icon: 'success', title: 'Success', text: res.message, timer: 2000, showConfirmButton: false });
            table.ajax.reload();
          }
        },
        error(xhr) {
          const json   = xhr.responseJSON;
          const errors = json?.errors ? json.errors.join('\n• ') : (json?.message || 'Save failed.');
          Swal.fire({ icon: 'error', title: 'Validation Error', html: '• ' + errors.replace(/\n/g, '<br>• ') });
        },
        complete() {
          $('#saveBtn').prop('disabled', false).text('Save Employee');
        }
      });
    });

    // Clear validation states when modal is closed
    $('#employeeModal').on('hidden.bs.modal', clearValidation);
  });
</script>
</body>
</html>